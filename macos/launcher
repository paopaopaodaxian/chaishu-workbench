#!/bin/bash
# 拆书工作台启动器：在后台启动本地服务，然后用默认浏览器打开页面。

# 以脚本为入口的 App 在 Apple 芯片上可能被当成 Intel 程序经 Rosetta 运行，
# 子进程（node、codex 等）也会跟着用 Intel 架构，导致找不到 Apple 芯片版组件。这里切回原生架构。
if [ "$(uname -m)" = "x86_64" ] && [ "$(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null)" = "1" ] && [ -z "$CHAISHU_ARCH_FIXED" ]; then
  export CHAISHU_ARCH_FIXED=1
  exec /usr/bin/arch -arm64 /bin/bash "$0" "$@"
fi

RES="$(cd "$(dirname "$0")/../Resources" && pwd -P)"
SUPPORT="$HOME/Library/Application Support/拆书工作台"
DATA="$SUPPORT/data"
LOG="$SUPPORT/server.log"
PORT="${CHAISHU_PORT:-8765}"
URL="http://127.0.0.1:$PORT"
mkdir -p "$SUPPORT"

alert() {
  local msg="${2//\"/\'}"; msg="${msg//\\/}"
  /usr/bin/osascript -e "display alert \"$1\" message \"$msg\" as critical" >/dev/null 2>&1
}
running() { /usr/bin/curl -s -m 2 "$URL/api/overview" 2>/dev/null | grep -q '"engines"'; }
APP_ROOT="$RES/app"

# 已经在运行：版本一致且页面正常，就直接打开；
# 版本不同（升级后）或页面打不开（旧版本的程序文件已被删除），先关掉它再启动当前版本。
# 不按路径比较：macOS 会把刚下载的应用放到随机的临时路径运行，同一个应用每次路径都可能不同。
if running; then
  MY_VERSION="$(cat "$APP_ROOT/VERSION" 2>/dev/null)"
  RUNNING_VERSION="$(/usr/bin/curl -s -m 2 "$URL/api/ping" 2>/dev/null | sed -n 's/.*"version": *"\([^"]*\)".*/\1/p')"
  PAGE_OK="$(/usr/bin/curl -s -m 3 -o /dev/null -w '%{http_code}' "$URL/" 2>/dev/null)"
  if [ "$PAGE_OK" = "200" ] && [ -n "$MY_VERSION" ] && [ "$RUNNING_VERSION" = "$MY_VERSION" ]; then
    open "$URL"; exit 0
  fi
  echo "$(date) 后台工作台版本为「${RUNNING_VERSION:-旧版本}」、页面状态 $PAGE_OK，当前应用版本 $MY_VERSION，关闭后重新启动" >>"$LOG"
  /usr/bin/curl -s -m 3 -X POST -d '{}' "$URL/api/shutdown" >/dev/null 2>&1
  for _ in $(seq 1 20); do sleep 0.25; running || break; done
fi

if /usr/sbin/lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  alert "无法启动拆书工作台" "端口 $PORT 被其他程序占用。如果之前在终端里启动过工作台，请先在那个终端按 Ctrl+C 关闭它，再双击打开。"
  exit 1
fi

# 双击启动的程序拿不到终端里的 PATH，这里从登录 shell 读取，保证能找到 claude / codex / node / python3
SHELL_PATH="$(/usr/bin/perl -e 'alarm 8; exec @ARGV' /bin/zsh -ilc 'printf "__P__%s\n" "$PATH"' </dev/null 2>/dev/null | grep '^__P__' | tail -1 | sed 's/^__P__//')"
NVM_BIN="$(ls -d "$HOME"/.nvm/versions/node/*/bin 2>/dev/null | sort -V | tail -1)"
export PATH="${SHELL_PATH:+$SHELL_PATH:}$HOME/.local/bin:$HOME/.npm-global/bin:${NVM_BIN:+$NVM_BIN:}$HOME/.volta/bin:$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

PY="$(command -v python3)"
if [ -z "$PY" ] || ! "$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null; then
  alert "未找到可用的 Python" "拆书工作台需要 Python 3.9 或更高版本。请在「终端」运行 xcode-select --install 安装命令行工具后再试。"
  exit 1
fi

echo "==== $(date) 启动（$PY，$(uname -m)）" >>"$LOG"
export NOVEL_DATA="$DATA" PORT CHAISHU_VERSION="$(cat "$APP_ROOT/VERSION" 2>/dev/null)"
nohup "$PY" "$APP_ROOT/server.py" >>"$LOG" 2>&1 </dev/null &
disown

for _ in $(seq 1 60); do
  sleep 0.25
  if running; then open "$URL"; exit 0; fi
done
alert "拆书工作台启动失败" "$(tail -6 "$LOG")

完整日志：$LOG"
exit 1
